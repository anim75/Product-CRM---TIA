{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build.cjs",
  "outputDirectory": "public",
  "functions": {
    "api/meeting-summary.js": {
      "maxDuration": 90
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitwithimtial",
      "destination": "/index.html"
    },
    {
      "source": "/sitwithimtial/api/meeting-summary",
      "destination": "/api/meeting-summary"
    },
    {
      "source": "/sitwithimtial/:path*",
      "destination": "/:path*"
    }
  ]
}
